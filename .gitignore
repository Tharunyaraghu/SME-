# Dependencies
node_modules/
*/node_modules/
**/node_modules/

# Local tooling & binaries
.bin/
*/.bin/
**/.bin/

# Production builds
dist/
*/dist/
**/dist/
build/
*/build/
**/build/

# Environment files
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor & OS files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

